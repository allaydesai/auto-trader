[Unit]
Description=Auto-Trader Automated Trading System
Documentation=https://github.com/yourusername/auto-trader
After=network.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/auto-trader
Environment="PATH=/home/trader/auto-trader/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/trader/auto-trader/src"

# Load environment variables from .env file
EnvironmentFile=/home/trader/auto-trader/.env

# Main execution command
ExecStart=/home/trader/auto-trader/.venv/bin/python /home/trader/auto-trader/run_auto_trader.py

# Restart configuration
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/home/trader/auto-trader/logs/systemd.log
StandardError=append:/home/trader/auto-trader/logs/systemd.error.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/auto-trader/data /home/trader/auto-trader/logs

# Resource limits
LimitNOFILE=4096
MemoryMax=2G
CPUQuota=200%

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target