# Auto-Trader Environment Configuration
# Copy this file to .env and update with your actual values
#
# This file contains DEPLOYMENT-SPECIFIC settings and SECRETS
# that should not be committed to version control.
#
# For application behavior settings, see config.yaml
# For user trading preferences, see user_config.yaml

# ============================================================
# IBKR CONNECTION SETTINGS (Deployment-specific)
# ============================================================
# These override the defaults and vary per deployment environment
IBKR_HOST=127.0.0.1        # TWS/Gateway host (127.0.0.1 for local, or remote IP)
IBKR_PORT=7497             # 7497 for TWS Paper, 7496 for TWS Live, 4002 for Gateway Paper, 4001 for Gateway Live
IBKR_CLIENT_ID=1           # Client ID (must be unique if multiple connections to same TWS/Gateway)

# ============================================================
# SECRETS AND API KEYS
# ============================================================
# Discord webhook URL for trade notifications
# Get this from Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# Future: Add other API keys here
# FMP_API_KEY=your_financial_modeling_prep_api_key
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ============================================================
# ENVIRONMENT-SPECIFIC OVERRIDES (Optional)
# ============================================================
# These override config.yaml settings for specific deployments

# Force simulation mode (overrides config.yaml setting)
# Uncomment to force simulation mode regardless of config.yaml
# SIMULATION_MODE=true

# Enable debug logging (overrides config.yaml logging.level)
# DEBUG=true

# ============================================================
# FILE PATHS (Optional - defaults will be used if not set)
# ============================================================
# Only set these if you need non-standard locations
# CONFIG_FILE=config.yaml
# USER_CONFIG_FILE=user_config.yaml
# LOGS_DIR=logs
# PLANS_DIRECTORY=data/trade_plans
# STATE_DIRECTORY=data/state