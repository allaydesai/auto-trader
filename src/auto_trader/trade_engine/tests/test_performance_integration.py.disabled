class PerformanceMetrics:
    """Collect and analyze performance metrics."""
    
    def __init__(self):
        self.start_time = None
        self.end_time = None
        self.operation_times = []
        self.memory_snapshots = []
        self.cpu_snapshots = []
        self.event_counts = {}
        
    def start_monitoring(self):
        """Start performance monitoring."""
        self.start_time = time.time()
        self.memory_snapshots.append(psutil.Process().memory_info().rss)
        self.cpu_snapshots.append(psutil.Process().cpu_percent())
        
    def record_operation(self, operation_name: str, duration: float):
        """Record operation timing."""
        if operation_name not in self.operation_times:
            self.operation_times[operation_name] = []
        self.operation_times[operation_name].append(duration)
        
    def increment_event(self, event_name: str):
        """Increment event counter."""
        self.event_counts[event_name] = self.event_counts.get(event_name, 0) + 1
        
    def stop_monitoring(self):
        """Stop performance monitoring and collect final metrics."""
        self.end_time = time.time()
        self.memory_snapshots.append(psutil.Process().memory_info().rss)
        self.cpu_snapshots.append(psutil.Process().cpu_percent(interval=0.1))
        
    def get_summary(self) -> Dict[str, Any]:
        """Get performance summary."""
        total_duration = self.end_time - self.start_time if self.end_time else 0
        
        operation_stats = {}
        for op_name, times in self.operation_times.items():
            operation_stats[op_name] = {
                "count": len(times),
                "total_time": sum(times),
                "avg_time": statistics.mean(times),
                "min_time": min(times),
                "max_time": max(times),
                "p95_time": statistics.quantiles(times, n=20)[18] if len(times) >= 20 else max(times)
            }
            
        memory_usage = {
            "start_mb": self.memory_snapshots[0] / (1024 * 1024) if self.memory_snapshots else 0,
            "end_mb": self.memory_snapshots[-1] / (1024 * 1024) if len(self.memory_snapshots) > 1 else 0,
            "peak_mb": max(self.memory_snapshots) / (1024 * 1024) if self.memory_snapshots else 0,
            "growth_mb": (self.memory_snapshots[-1] - self.memory_snapshots[0]) / (1024 * 1024) if len(self.memory_snapshots) > 1 else 0
        }
        
        return {
            "total_duration": total_duration,
            "operations": operation_stats,
            "memory": memory_usage,
            "cpu_usage": self.cpu_snapshots,
            "events": self.event_counts
        }


class HighFrequencyDataGenerator:
    """Generate high-frequency market data for performance testing."""
    
    def __init__(self, symbol: str, start_price: Decimal):
        self.symbol = symbol
        self.current_price = start_price
        self.timestamp = datetime.now(UTC)
        
    def generate_bars(self, count: int, frequency_ms: int = 100) -> List[BarData]:
        """Generate high-frequency bars."""
        bars = []
        
        for i in range(count):
            # Simulate realistic price movement
            price_change = Decimal(str((i % 10 - 5) * 0.01))  # -0.05 to +0.04
            self.current_price += price_change
            
            # Create OHLC with realistic relationships
            open_price = self.current_price - Decimal("0.01")
            high_price = max(open_price, self.current_price) + Decimal("0.02")
            low_price = min(open_price, self.current_price) - Decimal("0.02")
            close_price = self.current_price
            
            bar = BarData(
                symbol=self.symbol,
                timeframe="1min",
                timestamp=self.timestamp + timedelta(milliseconds=i * frequency_ms),
                open_price=open_price,
                high_price=high_price,
                low_price=low_price,
                close_price=close_price,
                volume=1000 + (i % 100) * 10,  # Varying volume
                is_complete=True
            )
            
            bars.append(bar)
            
        return bars


class FastOrderManager:
    """High-performance order manager for testing."""
    
    def __init__(self):
        self.order_counter = 0
        self.placed_orders = {}
        self.processing_times = []
        
    async def place_bracket_order(self, entry_order, stop_order, target_order):
        """Place bracket order with timing."""
        start_time = time.time()
        
        self.order_counter += 1
        order_id = f"FAST_ORDER_{self.order_counter:06d}"
        
        # Simulate minimal processing delay
        await asyncio.sleep(0.001)  # 1ms delay
        
        result = OrderResult(
            success=True,
            order_id=order_id,
            symbol=entry_order.symbol,
            quantity=entry_order.quantity,
            side=entry_order.side,
            fill_price=entry_order.price,
            status=OrderStatus.FILLED,
            timestamp=datetime.now(UTC)
        )
        
        self.placed_orders[order_id] = result
        
        processing_time = (time.time() - start_time) * 1000  # Convert to ms
        self.processing_times.append(processing_time)
        
        return result
        
    async def cancel_orders_for_symbol(self, symbol: str):
        """Fast order cancellation."""
        await asyncio.sleep(0.0005)  # 0.5ms delay
        return {"cancelled_orders": [], "success": True}
        
    async def get_order_status(self, order_id: str):
        """Fast status lookup."""
        return OrderStatus.FILLED
        
    def get_performance_stats(self) -> Dict[str, float]:
        """Get order processing performance stats."""
        if not self.processing_times:
            return {}
            
        return {
            "avg_processing_ms": statistics.mean(self.processing_times),
            "min_processing_ms": min(self.processing_times),
            "max_processing_ms": max(self.processing_times),
            "p95_processing_ms": statistics.quantiles(self.processing_times, n=20)[18] if len(self.processing_times) >= 20 else max(self.processing_times),
            "total_orders": len(self.processing_times)
        }


