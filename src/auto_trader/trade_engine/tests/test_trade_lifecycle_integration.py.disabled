class MarketDataSimulator:
    """Simulates realistic market data for testing."""
    
    def __init__(self):
        self.callbacks = []
        self.running = False
        
    def add_callback(self, callback):
        """Add callback for market data updates."""
        self.callbacks.append(callback)
        
    async def simulate_price_movement(
        self,
        symbol: str,
        start_price: Decimal,
        timeframe: str = "15min",
        duration_minutes: int = 30,
        price_change: Decimal = Decimal("0.50")
    ) -> List[BarData]:
        """Simulate realistic price movement."""
        bars = []
        current_time = datetime.now(UTC)
        current_price = start_price
        
        timeframe_minutes = 15 if timeframe == "15min" else 5
        num_bars = duration_minutes // timeframe_minutes
        price_increment = price_change / num_bars
        
        for i in range(num_bars):
            bar_time = current_time + timedelta(minutes=i * timeframe_minutes)
            
            # Create realistic OHLC
            open_price = current_price
            high_price = current_price + (price_increment * Decimal("0.3"))
            low_price = current_price - (price_increment * Decimal("0.2"))
            close_price = current_price + price_increment
            
            bar = BarData(
                symbol=symbol,
                timeframe=timeframe,
                timestamp=bar_time,
                open_price=open_price,
                high_price=high_price,
                low_price=low_price,
                close_price=close_price,
                volume=1000,
                is_complete=True
            )
            
            bars.append(bar)
            current_price = close_price
            
            # Notify callbacks
            for callback in self.callbacks:
                await callback(bar)
                await asyncio.sleep(0.01)  # Small delay for realism
                
        return bars


class OrderFillSimulator:
    """Simulates order execution with realistic delays and fills."""
    
    def __init__(self):
        self.pending_orders = {}
        self.fill_delay = 0.1  # 100ms delay
        
    async def simulate_order_fill(
        self,
        order_request: OrderRequest,
        fill_price: Optional[Decimal] = None
    ) -> OrderResult:
        """Simulate order execution with delay."""
        await asyncio.sleep(self.fill_delay)
        
        fill_price = fill_price or order_request.price
        
        return OrderResult(
            success=True,
            order_id=f"ORDER_{len(self.pending_orders) + 1:06d}",
            trade_plan_id=order_request.trade_plan_id,
            order_status=OrderStatus.FILLED,
            symbol=order_request.symbol,
            side=order_request.side,
            quantity=order_request.quantity,
            order_type=order_request.order_type,
            filled_quantity=order_request.quantity,
            average_fill_price=fill_price,
            timestamp=datetime.now(UTC)
        )


class MockRiskManager:
    """Mock risk manager for integration testing."""
    
    def __init__(self):
        self.account_balance = Decimal("100000.00")
        self.daily_loss_limit = Decimal("2000.00")
        self.current_daily_loss = Decimal("0.00")
        self.positions = {}
        
    async def validate_trade_request(self, trade_plan: TradePlan) -> Dict[str, Any]:
        """Validate trade request."""
        return {
            "passed": True,
            "checks": ["portfolio_limit", "position_size", "daily_loss"],
            "details": "All risk checks passed"
        }
        
    async def calculate_position_size(
        self,
        account_balance: Decimal,
        risk_percent: float,
        entry_price: Decimal,
        stop_price: Decimal
    ) -> int:
        """Calculate position size."""
        risk_amount = account_balance * Decimal(str(risk_percent / 100))
        price_diff = abs(entry_price - stop_price)
        if price_diff == 0:
            return 100  # Default size
        return int(risk_amount / price_diff)
        
    async def add_position(self, position_data: Dict[str, Any]) -> None:
        """Add position to risk registry."""
        self.positions[position_data["plan_id"]] = position_data
        
    async def remove_position(self, plan_id: str) -> None:
        """Remove position from risk registry."""
        self.positions.pop(plan_id, None)


