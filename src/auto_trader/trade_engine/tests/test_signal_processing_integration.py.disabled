class MockAdvancedRiskManager:
    """Advanced mock risk manager for detailed testing."""
    
    def __init__(self):
        self.account_balance = Decimal("100000.00")
        self.daily_loss_limit = Decimal("2000.00")
        self.current_daily_loss = Decimal("0.00")
        self.max_position_size = 1000
        self.risk_checks_enabled = True
        self.position_size_calculations = []
        self.validation_calls = []
        
    async def validate_trade_request(self, trade_plan: TradePlan) -> Dict[str, Any]:
        """Validate trade request with detailed tracking."""
        self.validation_calls.append({
            "plan_id": trade_plan.plan_id,
            "symbol": trade_plan.symbol,
            "timestamp": datetime.now(UTC)
        })
        
        if not self.risk_checks_enabled:
            return {
                "passed": False,
                "checks": ["risk_disabled"],
                "details": "Risk checks disabled for testing"
            }
            
        # Check daily loss limit
        if self.current_daily_loss >= self.daily_loss_limit:
            return {
                "passed": False,
                "checks": ["daily_loss_limit"],
                "details": f"Daily loss {self.current_daily_loss} exceeds limit {self.daily_loss_limit}"
            }
            
        # Check account balance
        if self.account_balance < Decimal("1000.00"):
            return {
                "passed": False,
                "checks": ["account_balance"],
                "details": f"Insufficient account balance: {self.account_balance}"
            }
            
        return {
            "passed": True,
            "checks": ["daily_loss_limit", "account_balance", "position_size"],
            "details": "All risk checks passed"
        }
        
    async def calculate_position_size(
        self,
        account_balance: Decimal,
        risk_percent: float,
        entry_price: Decimal,
        stop_price: Decimal
    ) -> int:
        """Calculate position size with tracking."""
        calculation = {
            "account_balance": account_balance,
            "risk_percent": risk_percent,
            "entry_price": entry_price,
            "stop_price": stop_price,
            "timestamp": datetime.now(UTC)
        }
        self.position_size_calculations.append(calculation)
        
        risk_amount = account_balance * Decimal(str(risk_percent / 100))
        price_diff = abs(entry_price - stop_price)
        
        if price_diff == 0:
            return 100
            
        calculated_size = int(risk_amount / price_diff)
        return min(calculated_size, self.max_position_size)
        
    def set_daily_loss(self, loss_amount: Decimal):
        """Set current daily loss for testing."""
        self.current_daily_loss = loss_amount
        
    def disable_risk_checks(self):
        """Disable risk checks for testing."""
        self.risk_checks_enabled = False
        
    def enable_risk_checks(self):
        """Enable risk checks for testing."""
        self.risk_checks_enabled = True


@pytest.fixture
def mock_advanced_risk_manager():
    """Create advanced mock risk manager."""
    return MockAdvancedRiskManager()


