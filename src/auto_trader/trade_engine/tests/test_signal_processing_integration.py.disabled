@pytest.mark.asyncio
@pytest.mark.integration
class TestSignalProcessingIntegration:
    """Integration tests for signal processing with risk management."""
    
    async def test_successful_signal_processing_with_risk_validation(
        self,
        signal_processor,
        sample_trade_plan,
        high_confidence_signal,
        mock_advanced_risk_manager,
        mock_order_execution_manager
    ):
        """Test successful signal processing with risk validation."""
        # Process the signal
        result = await signal_processor.process_entry_signal(
            signal=high_confidence_signal,
            trade_plan=sample_trade_plan
        )
        
        # Verify successful processing
        assert result.success is True
        assert result.risk_check_passed is True
        assert result.order_result is not None
        assert result.signal_confidence == 0.95
        assert result.plan_id == sample_trade_plan.plan_id
        
        # Verify risk manager was called
        assert len(mock_advanced_risk_manager.validation_calls) == 1
        validation_call = mock_advanced_risk_manager.validation_calls[0]
        assert validation_call["plan_id"] == sample_trade_plan.plan_id
        assert validation_call["symbol"] == sample_trade_plan.symbol
        
        # Verify position size was calculated
        assert len(mock_advanced_risk_manager.position_size_calculations) == 1
        size_calc = mock_advanced_risk_manager.position_size_calculations[0]
        assert size_calc["entry_price"] == sample_trade_plan.entry_level
        assert size_calc["stop_price"] == sample_trade_plan.stop_loss
        
        # Verify order was placed
        mock_order_execution_manager.place_bracket_order.assert_called_once()
    
    async def test_signal_rejected_by_risk_validation(
        self,
        signal_processor,
        sample_trade_plan,
        high_confidence_signal,
        mock_advanced_risk_manager
    ):
        """Test signal rejection due to risk validation failure."""
        # Configure risk manager to reject
        mock_advanced_risk_manager.set_daily_loss(Decimal("2500.00"))  # Exceeds limit
        
        # Process the signal
        result = await signal_processor.process_entry_signal(
            signal=high_confidence_signal,
            trade_plan=sample_trade_plan
        )
        
        # Verify rejection
        assert result.success is False
        assert result.risk_check_passed is False
        assert result.order_result is None
        assert "Daily loss" in result.error_message
        assert result.plan_id == sample_trade_plan.plan_id
        
        # Verify risk validation was attempted
        assert len(mock_advanced_risk_manager.validation_calls) == 1
    
    async def test_low_confidence_signal_filtering(
        self,
        signal_processor,
        sample_trade_plan,
        low_confidence_signal,
        mock_advanced_risk_manager
    ):
        """Test filtering of low confidence signals."""
        # Process low confidence signal
        result = await signal_processor.process_entry_signal(
            signal=low_confidence_signal,
            trade_plan=sample_trade_plan
        )
        
        # Verify signal was filtered out
        assert result.success is False
        assert "confidence" in result.error_message.lower()
        assert result.signal_confidence == 0.5
        
        # Risk validation should not have been called
        assert len(mock_advanced_risk_manager.validation_calls) == 0
    
    async def test_duplicate_signal_detection(
        self,
        signal_processor,
        sample_trade_plan,
        high_confidence_signal
    ):
        """Test duplicate signal detection and filtering."""
        # Process the same signal twice
        result1 = await signal_processor.process_entry_signal(
            signal=high_confidence_signal,
            trade_plan=sample_trade_plan
        )
        
        # Create duplicate signal (same timestamp)
        duplicate_signal = ExecutionSignal(
            action=ExecutionAction.ENTER_LONG,
            confidence=0.95,
            timestamp=high_confidence_signal.timestamp,  # Same timestamp
            context=high_confidence_signal.context
        )
        
        result2 = await signal_processor.process_entry_signal(
            signal=duplicate_signal,
            trade_plan=sample_trade_plan
        )
        
        # First signal should succeed
        assert result1.success is True
        
        # Second signal should be rejected as duplicate
        assert result2.success is False
        assert "duplicate" in result2.error_message.lower()
    
    async def test_concurrent_signal_processing_limit(
        self,
        signal_processor,
        mock_advanced_risk_manager,
        mock_order_execution_manager
    ):
        """Test concurrent signal processing limits."""
        # Create multiple trade plans
        trade_plans = [
            TradePlan(
                plan_id=f"CONCURRENT_SIGNAL_{i:03d}",
                symbol=f"TEST{i}",
                entry_level=Decimal("100.00"),
                stop_loss=Decimal("98.00"),
                take_profit=Decimal("105.00"),
                risk_category=RiskCategory.NORMAL,
                entry_function=ExecutionFunction(
                    function_type="close_above",
                    timeframe="15min",
                    parameters={"threshold": "100.00"}
                ),
                exit_function=ExecutionFunction(
                    function_type="stop_loss_take_profit",
                    timeframe="15min",
                    parameters={"stop_loss": "98.00", "take_profit": "105.00"}
                ),
                status=TradePlanStatus.AWAITING_ENTRY
            )
            for i in range(15)  # More than max_concurrent_signals (10)
        ]
        
        # Create signals for all plans
        signals = [
            ExecutionSignal(
                action=ExecutionAction.ENTER_LONG,
                confidence=0.9,
                timestamp=datetime.now(UTC),
                context={"plan_index": i}
            )
            for i in range(15)
        ]
        
        # Process all signals concurrently
        tasks = [
            signal_processor.process_entry_signal(signal, plan)
            for signal, plan in zip(signals, trade_plans)
        ]
        
        results = await asyncio.gather(*tasks, return_exceptions=True)
        
        # Count successful and rejected signals
        successful = sum(1 for r in results if isinstance(r, SignalProcessingResult) and r.success)
        rejected = sum(1 for r in results if isinstance(r, SignalProcessingResult) and not r.success)
        
        # Should have processed up to the limit
        assert successful <= 10  # Max concurrent limit
        assert successful + rejected == 15  # All signals accounted for
    
