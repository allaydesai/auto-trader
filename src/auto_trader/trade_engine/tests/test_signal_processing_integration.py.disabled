    async def test_signal_quality_threshold_filtering(
        self,
        signal_processor,
        sample_trade_plan,
        mock_advanced_risk_manager
    ):
        """Test signal quality threshold filtering."""
        # Create signal with low quality context
        low_quality_signal = ExecutionSignal(
            action=ExecutionAction.ENTER_LONG,
            confidence=0.9,  # High confidence but low quality context
            timestamp=datetime.now(UTC),
            context={
                "signal_quality": 0.6,  # Below quality threshold (0.8)
                "market_noise": "high",
                "volume_confirmation": False
            }
        )
        
        # Process signal
        result = await signal_processor.process_entry_signal(
            signal=low_quality_signal,
            trade_plan=sample_trade_plan
        )
        
        # Should be rejected due to low quality
        assert result.success is False
        assert "quality" in result.error_message.lower() or "threshold" in result.error_message.lower()
        
        # Risk validation should not have been called
        assert len(mock_advanced_risk_manager.validation_calls) == 0
    
    async def test_order_execution_failure_handling(
        self,
        signal_processor,
        sample_trade_plan,
        high_confidence_signal,
        mock_order_execution_manager
    ):
        """Test handling of order execution failures."""
        # Configure order execution to fail
        failed_order = OrderResult(
            success=False,
            order_id="FAILED_ORDER_001",
            symbol="AAPL",
            quantity=0,
            side=OrderSide.BUY,
            fill_price=Decimal("0.00"),
            status=OrderStatus.REJECTED,
            timestamp=datetime.now(UTC),
            error_message="Market closed"
        )
        
        mock_order_execution_manager.place_bracket_order.return_value = failed_order
        
        # Process signal
        result = await signal_processor.process_entry_signal(
            signal=high_confidence_signal,
            trade_plan=sample_trade_plan
        )
        
        # Signal processing should report failure
        assert result.success is False
        assert result.order_result is not None
        assert result.order_result.success is False
        assert "Market closed" in result.error_message
    
    async def test_signal_processing_metrics_and_logging(
        self,
        signal_processor,
        sample_trade_plan,
        high_confidence_signal
    ):
        """Test signal processing metrics collection and logging."""
        # Process multiple signals to generate metrics
        signals = [
            ExecutionSignal(
                action=ExecutionAction.ENTER_LONG,
                confidence=0.8 + (i * 0.02),
                timestamp=datetime.now(UTC),
                context={"signal_id": i}
            )
            for i in range(5)
        ]
        
        results = []
        for signal in signals:
            result = await signal_processor.process_entry_signal(signal, sample_trade_plan)
            results.append(result)
            await asyncio.sleep(0.01)  # Small delay between signals
        
        # Verify all signals were processed
        assert len(results) == 5
        
        # Check that metrics were collected
        # This would depend on the actual metrics implementation
        # For now, verify that processing completed without errors
        successful_results = [r for r in results if r.success]
        assert len(successful_results) > 0
        
        # Verify timestamps are properly set
        for result in results:
            assert result.timestamp is not None
            assert isinstance(result.timestamp, datetime)


@pytest.mark.asyncio
@pytest.mark.integration
class TestSignalProcessingEdgeCases:
    """Integration tests for signal processing edge cases."""
    
    async def test_signal_processing_with_zero_position_size(
        self,
        signal_processor,
        sample_trade_plan,
        high_confidence_signal,
        mock_advanced_risk_manager
    ):
        """Test handling when position size calculation returns zero."""
        # Override position size calculation to return zero
        async def zero_position_size(*args, **kwargs):
            return 0
            
        mock_advanced_risk_manager.calculate_position_size = zero_position_size
        
        result = await signal_processor.process_entry_signal(
            signal=high_confidence_signal,
            trade_plan=sample_trade_plan
        )
        
        # Should fail due to zero position size
        assert result.success is False
        assert "position size" in result.error_message.lower() or "zero" in result.error_message.lower()
    
    async def test_signal_processing_with_invalid_trade_plan(
        self,
        signal_processor,
        high_confidence_signal
    ):
        """Test signal processing with invalid trade plan."""
        # Create trade plan with invalid price levels
        invalid_plan = TradePlan(
            plan_id="INVALID_PLAN_001",
            symbol="AAPL",
            entry_level=Decimal("180.00"),
            stop_loss=Decimal("185.00"),  # Stop loss above entry (invalid for long)
            take_profit=Decimal("175.00"),  # Take profit below entry (invalid for long)
            risk_category=RiskCategory.NORMAL,
            entry_function=ExecutionFunction(
                function_type="close_above",
                timeframe="15min",
                parameters={"threshold": "180.00"}
            ),
            exit_function=ExecutionFunction(
                function_type="stop_loss_take_profit",
                timeframe="15min",
                parameters={"stop_loss": "185.00", "take_profit": "175.00"}
            ),
            status=TradePlanStatus.AWAITING_ENTRY
        )
        
        result = await signal_processor.process_entry_signal(
            signal=high_confidence_signal,
            trade_plan=invalid_plan
        )
        
        # Should fail due to invalid price levels
        assert result.success is False
        assert "invalid" in result.error_message.lower() or "price" in result.error_message.lower()